{
  "name": "smartstudy",
  "version": "1.0.0",
  "description": "智学助手 - 智能学习辅助工具",
  "main": "dist/main/main.js",
  "scripts": {
    "dev": "vite",
    "build:main": "tsc -p tsconfig.main.json",
    "build:preload": "tsc -p tsconfig.preload.json",
    "build:renderer": "vite build",
    "build": "npm run build:main && npm run build:preload && npm run build:renderer",
    "preview": "vite preview",
    "electron:dev": "npm run build:main && npm run build:preload && concurrently \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "electron:build": "npm run build && electron-builder",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx"
  },
  "dependencies": {
    "@ant-design/icons": "^5.2.6",
    "antd": "^5.12.0",
    "auto-launch": "^5.0.6",
    "cheerio": "^1.0.0-rc.12",
    "dayjs": "^1.11.10",
    "echarts": "^5.4.3",
    "echarts-for-react": "^3.0.2",
    "electron-store": "^8.1.0",
    "framer-motion": "^13.1.0",
    "openai": "^4.20.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.20.0",
    "sql.js": "^1.9.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/auto-launch": "^5.0.5",
    "@types/cheerio": "^0.22.35",
    "@types/node": "^20.10.0",
    "@types/react": "^18.2.37",
    "@types/react-dom": "^18.2.15",
    "@vitejs/plugin-react": "^4.2.0",
    "concurrently": "^8.2.2",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "typescript": "^5.3.2",
    "vite": "^5.0.0",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.smartstudy.app",
    "productName": "智学助手",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*"
    ],
    "extraResources": [
      {
        "from": "resources",
        "to": ".",
        "filter": [
          "*.wasm",
          "*.json",
          "*.png",
          "*.ico"
        ]
      }
    ],
    "win": {
      "target": "portable",
      "icon": "resources/icon.ico",
      "signAndEditExecutable": false,
      "sign": null,
      "signDlls": false
    },
    "linux": {
      "target": [
        "tar.gz"
      ],
      "icon": "resources/icon.png",
      "category": "Utility",
      "synopsis": "智能学习辅助工具",
      "description": "智学助手 - 番茄钟/题库/英语训练/知识库",
      "executableName": "smartstudy"
    },
    "mac": {
      "target": "dmg",
      "icon": "resources/icon.icns"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "asarUnpack": "**/*.node"
  }
}
